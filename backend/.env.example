# Meloyu 后端环境变量（复制为 .env 使用；.env 已 gitignore）
# ── 基础 ──
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
SERVER_NONCE=meloyu-local-nonce-v1
DATA_DIR=
HOST=127.0.0.1
PORT=8000
MUSIC_PROVIDER=localsynth

# ── 运行环境（v0.7.0）──
# dev=默认（本地开发）；production=启用启动断言（弱密钥/CORS * 拒启）、禁 demo 播种、关 /api/docs
ENV=dev
# 允许的前端来源（逗号分隔；禁止 * —— allow_credentials=True 下 * 会被启动断言拒绝）
CORS_ORIGINS=http://localhost:5173
# 对外可达基础 URL（Stripe Checkout 回跳 / 重置密码链接用）
APP_BASE_URL=http://localhost:5173

# ── Stripe 支付（v0.7.0，海外市场）──
# 未配置时付费档不可订阅（P0-4：无免费白拿付费档路径）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 订阅价格 ID（Stripe Dashboard 产品价格页复制 price_...）
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
# 积分充值包（一次性 $9.99 / 1000 积分；可按运营调整）
STRIPE_TOPUP_PRICE=
STRIPE_TOPUP_AMOUNT_USD=999
STRIPE_TOPUP_CREDITS=1000

# ── SMTP 邮件（找回密码 / 注册验证码）──
# 未配置 host 时相关功能返回明确运维提示
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Meloyu <no-reply@meloyu.example>
# 开启后注册需邮箱验证码（生产建议开启）
EMAIL_VERIFICATION_ENABLED=false

# ── 安全 / 加密（v0.7.0）──
# llm_settings API Key 落库 Fernet 加密密钥（openssl rand -base64 32；空=明文，仅 dev）
KEY_ENCRYPTION_SECRET=
# 注册时自动授予管理员（模型中心写操作）的邮箱，逗号分隔
ADMIN_EMAILS=

# ── 监控（可选）──
# pip install sentry-sdk 后配置即生效
SENTRY_DSN=

# ── 推理部署目录覆盖（默认 backend/data/ 下同名）──
ACESTEP_HOME=
AUDIOCPP_HOME=
# HuggingFace 镜像（如 https://hf-mirror.com）
HF_ENDPOINT=
