# Meloyu 生产环境变量模板（复制为 .env.prod 使用；.env.prod 已 gitignore）
# 用法：cd deploy && cp .env.prod.example .env.prod
# 生成强密钥：
#   JWT_SECRET=$(openssl rand -hex 48)
#   SERVER_NONCE=$(openssl rand -hex 24)
#   KEY_ENCRYPTION_SECRET=$(openssl rand -base64 32)

# ── 安全（ENV=production 下弱密钥直接拒启，见 app/main.py _assert_production）──
JWT_SECRET=
SERVER_NONCE=
# CORS 来源（逗号分隔，禁止 *）；与发布端口保持一致
CORS_ORIGINS=http://127.0.0.1:8180,http://localhost:8180
# 对外可达基础 URL（Stripe 回跳 / 密码重置链接）
APP_BASE_URL=http://127.0.0.1:8180

# ── 数据 / 通道 ──
# 容器内默认合成通道（纯 Python，无外部依赖；云端 MiniMax 通道在模型中心配 key）
MUSIC_PROVIDER=localsynth
# MiniMax 商用开放开关（义务已落实；条款修订/营收接近 $20M 时置 false 回退）
MMAX_COMMERCIAL_ENABLED=true

# ── 安全 / 加密 ──
# llm_settings API Key 落库 Fernet 密钥（历史明文记录兼容，下次保存自动升级密文）
KEY_ENCRYPTION_SECRET=
# 注册即授管理员的邮箱（逗号分隔）
ADMIN_EMAILS=

# ── Stripe 支付（未配置时付费档不可订阅）──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_TOPUP_PRICE=
STRIPE_TOPUP_AMOUNT_USD=999
STRIPE_TOPUP_CREDITS=1000

# ── SMTP 邮件（未配置 host 时找回密码/验证码功能返回运维提示）──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Meloyu <no-reply@meloyu.example>
EMAIL_VERIFICATION_ENABLED=false

# ── 监控（可选）──
SENTRY_DSN=

# ── 推理目录覆盖 / HF 镜像 ──
# 本地推理通道（acestep/audiocpp/sg2）在容器内不可用，见 README「已知限制」；
# 自托管端点默认 127.0.0.1 容器内不可达，需在模型中心改为
# http://host.docker.internal:<port> 才能访问宿主机服务
ACESTEP_HOME=
AUDIOCPP_HOME=
HF_ENDPOINT=
