# Meloyu Enterprise 私有化部署环境模板（P4，2026-10-03）
# 用法：cp env.enterprise.example ../backend/.env（或 compose env_file 挂载）
# 对应 compose：deploy/docker-compose.yml（postgres + backend + frontend 三服务不变）

# ---- 产品形态 ----
APP_MODE=enterprise
ENV=production

# ---- 数据库（compose 内 postgres 服务）----
DATABASE_URL=postgresql+psycopg2://meloyu:<强密码>@postgres:5432/meloyu

# ---- 安全基线（生产断言强制，弱值拒启动）----
JWT_SECRET=<openssl rand -base64 48>
SERVER_NONCE=<openssl rand -base64 24>
KEY_ENCRYPTION_SECRET=<openssl rand -base64 32>   # 第三方 API Key 落库 Fernet 加密

# ---- License（portal 签发的 enterprise 档 Key，启动断言 fail-fast）----
LICENSE_PUBLIC_KEY=<公钥 b64，与 portal 同 keypair>
MELOYU_LICENSE_KEY=<v1.xxxx.xxxx 企业授权 Key>

# ---- 管理员（注册时按邮箱自动授予；模型中心/档位工具用）----
ADMIN_EMAILS=admin@yourcorp.example

# ---- 可选：SMTP（邮箱验证/找回密码）----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Meloyu <no-reply@yourcorp.example>

# ---- 反代（自有 nginx/Traefik 之后开启）----
TRUST_PROXY=true

# ---- 销售联系（团队档提示）----
SALES_CONTACT_EMAIL=sales@yourcorp.example

# ---- 本地推理组件（按需，路径对应 bind mount backend/data）----
# ACESTEP_HOME=/app/data/acestep
# AUDIOCPP_HOME=/app/data/audiocpp
# HF_ENDPOINT=https://hf-mirror.com
